    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7474/db/lejeloven/query/v2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ statement: \"CALL db.index.vector.queryNodes('stykke_embedding', $k, $embedding) YIELD node, score RETURN node.id AS id, node.paragraf AS paragraf, node.stk AS stk, node.kapitel AS kapitel, node.kapitel_titel AS kapitel_titel, node.overskrift AS overskrift, node.tekst AS tekst, node.kilde AS kilde, round(score, 3) AS score ORDER BY score DESC\", parameters: { embedding: $json.embeddings[0], k: 5 } }) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth"
      },
      "id": "v4",
      "name": "Vektorsøgning i Neo4j",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Gør Neo4j's svar læsbart for agenten: tekst + paragraf + kilde for hvert fund\nconst { fields, values } = $input.first().json.data;\nconst fund = values.map(v => Object.fromEntries(fields.map((f, i) => [f, v[i]])));\n\nif (!fund.length) {\n  return [{ json: { resultat: 'Ingen relevante stykker fundet i lejeloven.', fund: [] } }];\n}\n\nconst resultat = fund.map((r, i) => [\n  `[${i + 1}] Lejeloven § ${r.paragraf}, stk. ${r.stk}` +\n    ` (kapitel ${r.kapitel}: ${r.kapitel_titel}${r.overskrift ? ' – ' + r.overskrift : ''})` +\n    ` – relevans ${r.score}`,\n  r.tekst,\n  `Kilde: ${r.kilde}`,\n].join('\\n')).join('\\n\\n');\n\nreturn [{ json: { resultat, fund } }];\n"
      },
      "id": "v5",
      "name": "Formatér resultat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    }
  ],
