    },
    {
      "parameters": {
        "jsCode": "// Gør Neo4j's svar læsbart for agenten: tekst + paragraf + kilde for hvert fund\nconst { fields, values } = $input.first().json.data;\nconst fund = values.map(v => Object.fromEntries(fields.map((f, i) => [f, v[i]])));\n\nif (!fund.length) {\n  return [{ json: { resultat: 'Ingen relevante stykker fundet i lejeloven.', fund: [] } }];\n}\n\nconst resultat = fund.map((r, i) => [\n  `[${i + 1}] Lejeloven § ${r.paragraf}, stk. ${r.stk}` +\n    ` (kapitel ${r.kapitel}: ${r.kapitel_titel}${r.overskrift ? ' – ' + r.overskrift : ''})` +\n    ` – relevans ${r.score}`,\n  r.tekst,\n  `Kilde: ${r.kilde}`,\n].join('\\n')).join('\\n\\n');\n\nreturn [{ json: { resultat, fund } }];\n"
      },
      "id": "fcce2cc4-6bd1-46c6-92e0-ef3f3f21d4fb",
